# NoticeSaathi Environment Configuration Template

# Server Configuration
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string-in-production
API_V1_STR=/api/v1

# Database Configuration
# Local development default: sqlite:///./notice_saathi_v2.db
# Production PostgreSQL example: postgresql://saathi_user:saathi_pass@postgres:5432/notice_saathi
DATABASE_URL=sqlite:///./notice_saathi_v2.db

# Storage Configuration
# Local storage directory path (private, never served publicly)
STORAGE_LOCAL_DIR=./data/storage
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB
MAX_PAGES_PER_DOC=20

# Gnani AI Configuration (Speech-to-Text & Text-to-Speech)
# Obtain API key from: https://app.gnani.ai/voice
# If unset, the system runs with transparent mock providers for offline development and testing.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v2.5

# Localization & Preferences
DEFAULT_LANGUAGE=te-IN
GUEST_SESSION_EXPIRE_HOURS=24
RETENTION_HOURS=48

