# NoticeSaathi Environment Configuration Template
# Copy this file to .env and customize for your environment.
# NEVER commit the active .env file containing real API keys or secrets to git.

# ==============================================================================
# 1. CORE BACKEND CONFIGURATION (FastAPI)
# ==============================================================================
ENVIRONMENT=development
DEBUG=true

# In production: Must be set to a cryptographically random string (min 32 chars).
# Generate with: `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=notice-saathi-development-secret-key-change-in-prod-32bytes
API_V1_STR=/api/v1

# ==============================================================================
# 2. CORS CONFIGURATION
# ==============================================================================
# Comma-separated list of allowed origins.
# In development, defaults to: http://localhost:3000,http://127.0.0.1:3000
# In production, wildcard '*' with credentials is strictly prohibited.
# Example: CORS_ALLOWED_ORIGINS=https://noticesaathi.org,https://api.noticesaathi.org
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# 3. DATABASE CONFIGURATION
# ==============================================================================
# Local development default: SQLite
DATABASE_URL=sqlite:///./notice_saathi_v2.db

# Production PostgreSQL example (Cloud SQL):
# DATABASE_URL=postgresql://notice_user:notice_password@127.0.0.1:5432/notice_saathi

# ==============================================================================
# 4. STORAGE CONFIGURATION
# ==============================================================================
# Local storage directory path (private, never served publicly directly)
STORAGE_LOCAL_DIR=./data/storage
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB
MAX_PAGES_PER_DOC=20

# ==============================================================================
# 5. GNANI AI CONFIGURATION (STT & TTS)
# ==============================================================================
# Gnani AI API key for Prisma Speech-to-Text and Timbre Text-to-Speech
# Obtain from: https://app.gnani.ai/voice
# If unset or empty, the backend falls back to transparent mock adapters for local dev & testing.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v2.5

# Test execution gate for live Gnani network calls (set to 1 to run live cloud tests)
# RUN_LIVE_GNANI_TESTS=0

# ==============================================================================
# 6. TRANSLATION PROVIDER CONFIGURATION (Optional Cloud Providers)
# ==============================================================================
# Options: auto (default), gemini, google, azure, or mock
TRANSLATION_PROVIDER=auto
TRANSLATION_TIMEOUT_SECONDS=15.0
TRANSLATION_MAX_RETRIES=2
REQUIRE_CONSENT_FOR_CLOUD_TRANSLATION=true

# Optional cloud translation credentials (used only if provider is configured)
GEMINI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=centralindia

# ==============================================================================
# 7. LOCALIZATION & DATA RETENTION
# ==============================================================================
DEFAULT_LANGUAGE=te-IN
GUEST_SESSION_EXPIRE_HOURS=24
RETENTION_HOURS=48

# ==============================================================================
# 8. FRONTEND CONFIGURATION (Next.js)
# ==============================================================================
# Public base URL of the FastAPI backend for browser API calls
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public URL of the frontend application
NEXT_PUBLIC_APP_URL=http://localhost:3000
